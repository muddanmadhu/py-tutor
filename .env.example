# ---------------------------------------------------------------------------
# PyForge environment configuration
# Copy to `.env` and adjust. Never commit a populated `.env`.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
PYFORGE_ENV=development                 # development | test | production
PYFORGE_DEBUG=true
PYFORGE_LOG_LEVEL=INFO
PYFORGE_LOG_JSON=false                  # true in production for structured logs

# --- Security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PYFORGE_SECRET_KEY=change-me-in-production-this-value-is-not-secret
PYFORGE_ACCESS_TOKEN_TTL_MINUTES=30
PYFORGE_REFRESH_TOKEN_TTL_DAYS=14
PYFORGE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Identity ---------------------------------------------------------------
# Leave empty to use this application's own email/password accounts.
# Set it to delegate sign-in to Firebase Authentication: bearer tokens are then
# verified as Firebase ID tokens and accounts are provisioned on first sign-in.
# The project id is public — it is not a credential, and no service-account key
# is needed because verification uses Google's published JWKS.
PYFORGE_FIREBASE_PROJECT_ID=

# --- Database --------------------------------------------------------------
# Postgres (docker compose default):
PYFORGE_DATABASE_URL=postgresql+psycopg://pyforge:pyforge@localhost:5432/pyforge
# SQLite (zero-infrastructure local dev):
# PYFORGE_DATABASE_URL=sqlite+pysqlite:///./pyforge.db
# Neon (serverless Postgres; note the required sslmode):
# PYFORGE_DATABASE_URL=postgresql+psycopg://user:pw@ep-xxx.region.aws.neon.tech/pyforge?sslmode=require

# --- Cache / queue ---------------------------------------------------------
PYFORGE_REDIS_URL=redis://localhost:6379/0

# --- Execution engine ------------------------------------------------------
# docker    → hardened container per run (isolation on the server)
# client    → no server sandbox; the browser runs the code under Pyodide and
#             reports the result for grading. Required on hosts that cannot
#             launch containers (Cloud Run, Render, Railway).
# subprocess→ rlimit-constrained local process (DEV ONLY, weaker isolation)
PYFORGE_EXECUTOR=docker
PYFORGE_RUNNER_IMAGE=pyforge/runner:latest
PYFORGE_EXEC_TIMEOUT_SECONDS=10
PYFORGE_EXEC_MEMORY_MB=256
PYFORGE_EXEC_CPUS=0.5
PYFORGE_EXEC_PIDS_LIMIT=64
PYFORGE_EXEC_MAX_OUTPUT_BYTES=65536
PYFORGE_EXEC_MAX_FILES=25
PYFORGE_EXEC_MAX_SOURCE_BYTES=262144
PYFORGE_EXEC_MAX_CONCURRENT=8
PYFORGE_EXEC_RATE_LIMIT_PER_MINUTE=60

# --- AI tutor --------------------------------------------------------------
# Leave empty to run the deterministic offline tutor (no network calls).
PYFORGE_ANTHROPIC_API_KEY=
PYFORGE_AI_MODEL=claude-sonnet-5
PYFORGE_AI_MAX_TOKENS=1200
PYFORGE_AI_DAILY_MESSAGE_LIMIT=200

# --- Frontend --------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

# Firebase web config. Public by design: it identifies the project, it does not
# authorise anything. Leave empty to use local email/password accounts instead.
# Find these in Firebase console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
